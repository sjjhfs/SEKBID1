rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY:
     * This ruleset implements a Role-Based Access Control (RBAC) model focused on administrative 
     * oversight and collaborative data modification. It prioritizes rapid iteration by 
     * enforcing authorization (who can access) while remaining flexible on data schema.
     *
     * DATA STRUCTURE:
     * - /members/{memberId}: Publicly readable member profiles for signed-in users.
     * - /app_statistics/globalStats: A singleton for tracking application-wide metrics.
     * - /roles_admin/{userId}: A lookup collection where the existence of a UID document 
     *   grants administrative privileges.
     *
     * KEY SECURITY DECISIONS:
     * - Admin roles are validated via document existence in the 'roles_admin' collection.
     * - Authenticated users are permitted to create, update, and delete member data to support 
     *   the prototype's administrative workflow (which is gated by a client-side password).
     * - Read access is restricted to authenticated users to protect member identity and privacy.
     */

    // --- Helper Functions ---

    /** 
     * @description Checks if the request is made by an authenticated user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /** 
     * @description Checks if the authenticated user has an entry in the roles_admin collection.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /** 
     * @description Verifies a document exists before allowing update/delete.
     */
    function isExisting() {
      return resource != null;
    }

    // --- Collection Rules ---

    /**
     * @description Rules for Member documents. All users can read, create, update, and delete.
     * @path /members/{memberId}
     */
    match /members/{memberId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExisting();
      allow delete: if isSignedIn() && isExisting();
    }

    /**
     * @description Rules for the Global Statistics singleton. All users can view and modify.
     * @path /app_statistics/globalStats
     */
    match /app_statistics/{statId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExisting();
      allow delete: if isSignedIn() && isExisting();
    }

    /**
     * @description Rules for Admin Roles. Used to determine administrative privileges.
     * @path /roles_admin/{userId}
     */
    match /roles_admin/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && isExisting();
      allow delete: if isAdmin() && isExisting();
    }
  }
}